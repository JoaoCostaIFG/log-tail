<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>The Daily Tech Dispatch — {{ date_label }}{% if is_show %} — Show HN{% elif page_number and page_number > 1 %} — Page {{ page_number }}{% endif %}</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="{{ base }}style.css?v={{ css_version }}">
</head>
<body>
<div class="paper">

  <header class="masthead">
    <nav class="topbar">
      <a href="{{ base }}{{ hrefs.front }}">Front Page</a>
      <a href="{{ base }}{{ hrefs.show }}">Show HN</a>
      <a href="{{ base }}{{ hrefs.front }}#archive">Archive</a>
    </nav>
    <h1><a class="masthead-link" href="{{ base }}{{ hrefs.front }}">The Daily Tech Dispatch</a></h1>
    <p class="edition-line">
      <span>Vol. {{ volume }} · No. {{ edition_no }}</span>
      <span>{{ date_label }}</span>
      <span>UTC Edition</span>
    </p>
  </header>

  {% macro story(s) %}
  <article class="story">
    {% if s.image %}<img class="thumb{% if s.image_full %} full{% endif %}" src="{{ s.image }}" alt="{{ s.title }}" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}
    <h3 class="headline"><a href="{{ s.link }}">{{ s.title }}</a></h3>
    <p class="dateline">
      {%- for src in s.sources %}<span class="badge">{{ src }}</span>{% endfor %}
      {{ s.points }} points · by {{ s.by }} · {{ s.domain }} · <a class="discuss" href="{{ s.item_url }}">discuss</a>
    </p>
    {% if s.lede and not s.image_full %}<p class="lede">{{ s.lede }}</p>{% endif %}
  </article>
  {% endmacro %}

  {% if lead %}
  <article class="lead story">
    <p class="kicker">Top Story</p>
    {% if lead.image %}<img class="lead-photo{% if lead.image_full %} full{% endif %}" src="{{ lead.image }}" alt="{{ lead.title }}" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}
    <h2 class="headline"><a href="{{ lead.link }}">{{ lead.title }}</a></h2>
    <p class="dateline">
      {%- for src in lead.sources %}<span class="badge">{{ src }}</span>{% endfor %}
      {{ lead.points }} points · by {{ lead.by }} · {{ lead.domain }} · <a class="discuss" href="{{ lead.item_url }}">discuss</a>
    </p>
    {% if lead.lede %}<p class="lede">{{ lead.lede }}</p>{% endif %}
  </article>
  {% endif %}

  {% if is_show %}
  <section id="show-hn">
    <h2 class="section-title">Show HN — Best of the Day</h2>
    <div class="columns">
      {% for s in show_hn %}{{ story(s) }}{% endfor %}
    </div>
  </section>
  {% else %}
  <section id="front-page">
    <h2 class="section-title">{% if page_number == 1 %}Front Page{% else %}Page {{ page_number }}{% endif %}</h2>
    <div class="columns">
      {% for s in stories %}{{ story(s) }}{% endfor %}
    </div>
  </section>
  {% endif %}

  <nav class="pagination" aria-label="Pages">
    {% if hrefs.prev %}<a class="pg-arrow" href="{{ base }}{{ hrefs.prev }}">‹</a>{% endif %}
    {% for p in pagination %}
      {% if p.current %}<span class="pg-current">{{ p.label }}</span>
      {% else %}<a href="{{ base }}{{ p.href }}">{{ p.label }}</a>{% endif %}
    {% endfor %}
    {% if hrefs.next %}<a class="pg-arrow" href="{{ base }}{{ hrefs.next }}">›</a>{% endif %}
  </nav>

  {% if page_number == 1 and not is_show %}
  <section id="archive">
    <h2 class="section-title">Recent Editions</h2>
    {% if archives %}
    <ul class="archive-list">
      {% for a in archives %}<li><a href="{{ base }}archive/{{ a.date }}.html">{{ a.label }}</a></li>{% endfor %}
    </ul>
    {% else %}
    <p class="archive-empty">First edition — the archive starts tomorrow.</p>
    {% endif %}
  </section>
  {% endif %}

  <footer>
    <p>Assembled automatically each day from <a href="https://news.ycombinator.com/">Hacker News</a> and <a href="https://lobste.rs/">lobste.rs</a>. Not affiliated with either.</p>
    <p>{{ stats.total }} stories · {{ stats.merged }} cross-posts merged · {{ stats.excerpts }} excerpts · {{ stats.images }} images</p>
  </footer>

</div>
</body>
</html>
